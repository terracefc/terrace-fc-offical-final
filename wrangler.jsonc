{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "terrace-fc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "terracefc.com/*", "zone_name": "terracefc.com" },
    { "pattern": "www.terracefc.com/*", "zone_name": "terracefc.com" }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
